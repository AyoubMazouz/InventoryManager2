<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Manager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/inventoryManager.styles.css" asp-append-version="true" />
</head>
<body class="d-flex" style="overflow-y: scroll; overflow-x: hidden; margin-bottom: -100px;">
    @using Microsoft.AspNetCore.Identity
    @inject SignInManager<User> SignInManager
    @inject UserManager<User> UserManager

    @Html.AntiForgeryToken()

    @if (TempData["Alert.Message"] != null)
    {
        <div class="alert @TempData["Alert.Type"] alert-dismissible fade show w-25 d-flex justify-content-between align-items-center position-absolute"
                role="alert" style="z-index: 1050; right: 1rem; top: 1rem;">
            <p>@TempData["Alert.Message"]</p>
            <button onclick="handleAlertOnClose()" class="btn btn-outline-secondary" data-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @* Sidebar *@
    <header style="position: sticky; top: 0%; width: 280px; height: 100vh;" class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark">
        <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="fa-solid fa-boxes-stacked me-2 fa-2x"></i>
            <div>
                <div>Gestionnaire</div>
                <div class="fw-bold text-primary">
                    d'inventaire
                </div>
            </div>
        </a>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            @{
                string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
            }
            <li>
                <a asp-controller="Inventory" asp-action="Index"
                   class="nav-link nav-link text-white @(controller == "Inventory" && action == "Index" ? "active" : "")">
                    <i class="fa-solid fa-warehouse me-2"></i>
                    Inventory
                </a>
            </li>
            <li>
                <a asp-controller="Supplier" asp-action="Index"
                   class="nav-link text-white @(controller == "Supplier" && action == "Index" ? "active" : "")">
                    <i class="fa-solid fa-boxes-packing me-2"></i>
                    Fournisseurs
                </a>
            </li>
            <li>
                <a asp-controller="Category" asp-action="Index"
                   class="nav-link text-white @(controller == "Category" && action == "Index" ? "active" : "")">
                    <i class="fa-solid fa-list me-2"></i>
                    Catégories
                </a>
            </li>
            <li>
                <a asp-controller="User" asp-action="Index"
                   class="nav-link text-white @(controller == "User" && action == "Index" ? "active" : "")">
                    <i class="fa-solid fa-users me-2"></i>
                    Utilisateurs
                </a>
            </li>
            <li>
                <a asp-controller="Role" asp-action="Index"
                   class="nav-link text-white @(controller == "Role" && action == "Index" ? "active" : "")">
                    <i class="fa-solid fa-users-gear me-2"></i>
                    Rôles
                </a>
            </li>
        </ul>

        <hr>
           
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="https://github.com/mdo.png" alt="" width="32" height="32" class="rounded-circle me-2">
                    <strong>@UserManager.GetUserName(User)</strong>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="fa-solid fa-sliders me-2"></i>
                            Settings
                        </a>
                    </li>
                    <li><a class="dropdown-item" href="#">
                            <i class="fa-solid fa-user me-2"></i>
                            Profile
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form id="account" method="post" asp-area="Identity" asp-page="/Account/Logout" class="dropdown-item">
                            <button type="submit" class="text-danger d-flex align-items-center" style="padding: 0; border: none; background: none;">
                                <i class="fa-solid fa-right-from-bracket text-danger me-2"></i>
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a id="account" method="post" asp-area="Identity" asp-action="/Account/Login" class="btn btn-info">
                <i class="fa-solid fa-user-plus me-2"></i>
                se connecter
            </a>
        }

    </header>

    <main role="main" class="flex-grow-1 container py-3">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(document).ready(function () {
            setTimeout(() => {
                $('div[role="alert"]').remove();
            }, 7000)
        })

        function handleAlertOnClose() {
            $('div[role="alert"]').remove();
        }
    </script>
</body>
</html>
