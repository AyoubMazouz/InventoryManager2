@model InventoryManager2.ViewModels.CreateUserVM

@{
    ViewData["Title"] = "Créer";
}

<div class="d-flex justify-content-between align-items-end">
    <a asp-action="Index"><i class="fa-solid fa-angle-left me-2"></i>Retour à la liste</a>

    <h1>Créer un nouvel utilisateur</h1>

    <div></div>
</div>

<hr />

<div class="row">
    <div class="col-md-8 mx-auto">
        <form asp-action="Create" class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group col-12 mt-2">
                <label asp-for="UserName" class="control-label">Nom d'utilisateur</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group col-12 mt-2">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group col-12 mt-2">
                <label asp-for="PhoneNumber" class="control-label">Numéro de téléphone</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group col-12 mt-2">
                <label asp-for="Password" class="control-label">Mot de passe</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group col-12 mt-2">
                <label asp-for="EmailConfirmed" class="control-label">Email confirmé</label>
                <input asp-for="EmailConfirmed" type="checkbox" class="form-check-input" />
                <span asp-validation-for="EmailConfirmed" class="text-danger"></span>
            </div>

            <div class="form-group col-12 mt-2">
                <label asp-for="PhoneNumberConfirmed" class="control-label">Numéro de téléphone confirmé</label>
                <input asp-for="PhoneNumberConfirmed" type="checkbox" class="form-check-input" />
                <span asp-validation-for="PhoneNumberConfirmed" class="text-danger"></span>
            </div>

            <div class="form-group d-flex justify-content-end col-12 mt-3">
                <input type="submit" value="Créer" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
