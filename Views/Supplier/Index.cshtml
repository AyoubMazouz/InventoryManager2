@model PaginationVM<SupplierVM>

@{
    ViewData["Title"] = "Fournisseurs";
}

@* Options *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
        @* Sort Dropdown *@
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle remove-dropdown-carrot"
                    type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                @if (ViewBag.sortDirection == "asc")
                {
                    <i class="fa-solid fa-arrow-up-wide-short"></i>
                }
                else
                {
                    <i class="fa-solid fa-arrow-down-short-wide"></i>
                }
            </button>
            <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                <li class="dropdown-item">
                    <a asp-action="Index" class="text-decoration-none text-dark"
                       asp-route-sortDir="asc"
                       asp-route-sortBy="Name"
                       asp-route-search="@ViewBag.search"
                       asp-route-page="@ViewBag.page"
                       asp-route-pageSize="@ViewBag.pageSize">
                        @Html.DisplayNameFor(model => model.Items.First().Name) (Ascendant)
                    </a>
                </li>
                <li class="dropdown-item">
                    <a asp-action="Index" class="text-decoration-none text-dark"
                       asp-route-sortDir="desc"
                       asp-route-sortBy="Name"
                       asp-route-search="@ViewBag.search"
                       asp-route-page="@ViewBag.page"
                       asp-route-pageSize="@ViewBag.pageSize">
                        @Html.DisplayNameFor(model => model.Items.First().Name) (Descendant)
                    </a>
                </li>
            </ul>
        </div>
        @* Filter Trigger *@
        <button data-bs-toggle="modal" data-bs-target="#filterDialog" class="btn btn-outline-secondary">
            <i class="fa-solid fa-filter"></i>
        </button>
        <form method="get" action="@Url.Action("Index")" class="d-flex">
            <input type="text" name="search" value="@ViewBag.search" class="form-control me-2" placeholder="Rechercher par nom">
            <button class="btn btn-outline-secondary" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </form>
    </div>
    <div class="d-flex align-items-center gap-2">
        @* Export *@
        <form method="post" asp-action="Export" class="d-inline">
            <div class="form-group d-inline-flex align-items-center">
                <select id="exportType" name="exportType" class="form-select me-2">
                    <option value="xlsx">Excel (.xlsx)</option>
                    <option value="csv">CSV (.csv)</option>
                </select>
                <button type="submit" class="btn btn-outline-primary">Exporter</button>
            </div>
        </form>
        @* Import *@
        <form method="post" asp-action="Import" class="d-inline">
            <div class="form-group d-inline-flex align-items-center">
                <button type="submit" disabled class="btn btn-primary">Importer</button>
            </div>
        </form>
        @* Create New*@
        <a asp-action="Create" class="btn btn-success me-2">Créer Nouveau</a>
    </div>
</div>

@* Data *@
<div class="table-container">
    <table class="table table-striped table-bordered">
        <thead class="bg-primary text-light">
            <tr>
                <th>
                    <a asp-action="Index" class="text-light"
                       asp-route-sortDirection="@(ViewBag.sortDirection == "asc" ? "desc" : "asc")"
                       asp-route-search="@ViewBag.search"
                       asp-route-page="@ViewBag.page"
                       asp-route-pageSize="@ViewBag.pageSize"
                       asp-route-sortColumn="Name">
                        @Html.DisplayNameFor(model => model.Items.First().Name)
                    </a>
                    @if (ViewBag.sortDir == "asc")
                    {
                        <i class="fa-solid fa-sort-down"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-sort-up"></i>
                    }
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().ContactInfo)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">@Html.DisplayFor(modelItem => item.Name)</a>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ContactInfo)
                    </td>
                    <td class="text-end">
                        <div class="dropdown">
                            <a class="btn btn-secondary dropdown-toggle btn-rounded remove-dropdown-carrot" href="#" role="button" id="dropdownMenuButton"
                               data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton">
                                <a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-eye"></i> Voir
                                </a>
                                <div class="dropdown-divider"></div>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-pencil-alt"></i> Modifier
                                </a>
                                <a href="#" class="dropdown-item d-flex align-items-center gap-2" data-bs-toggle="modal"
                                   data-bs-target="#deleteDialog" onclick="handleOpenDeleteDialog(@item.Id)">
                                    <i class="fa-solid fa-trash"></i> Supprimer
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Pagination *@
@{
    var paginationModel = new PaginationVM
            {
                PageNumber = Model.PageNumber,
                PageSize = Model.PageSize,
                TotalItems = Model.TotalItems
            };
    @await Html.PartialAsync("_PaginationPartial", paginationModel)
}

@* Filters Dialog *@
<div class="modal fade" id="filterDialog" tabindex="-1" aria-labelledby="filterDialogLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filterDialogLabel">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                Le filtre arrive bientôt !
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

@* Confirm Deletion Dialog *@
<div class="modal fade" id="deleteDialog" tabindex="-1" aria-labelledby="deleteDialogLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteDialogLabel">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer ce fournisseur ?
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" id="deleteItemId" name="id" />
                    <input type="submit" value="Supprimer" class="btn btn-danger" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function handleOpenDeleteDialog(id) {
        $("#deleteItemId").val(id);
        $("#deleteForm").attr("action", '@Url.Action("Delete")/' + id);
    }
</script>
